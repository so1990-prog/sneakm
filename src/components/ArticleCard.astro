---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
  size?: 'large' | 'medium' | 'small'
}

const { post, size = 'medium' } = Astro.props
const { title, date, category, type, excerpt, cover, coverAlt } = post.data

const dateStr = date.toLocaleDateString('ja-JP', {
  year: 'numeric', month: '2-digit', day: '2-digit'
}).replace(/\//g, '.')
---

<a href={`/${post.slug}`} class={`acard acard--${size}`}>
  <div class="acard-img-wrap">
    {cover
      ? <Image src={cover} alt={coverAlt ?? title} widths={[400, 800]} class="acard-img" />
      : <div class="acard-img-ph" />
    }
    <span class:list={['acard-tag', type === 'note' && 'acard-tag--note']}>
      {type === 'note' ? 'NOTE' : 'SITE'}
    </span>
  </div>
  <div class="acard-body">
    <span class:list={['acard-type', type === 'note' && 'acard-type--note']}>
      {category.toUpperCase()}
    </span>
    <h2 class="acard-title">{title}</h2>
    {excerpt && <p class="acard-excerpt">{excerpt}</p>}
    <div class="acard-foot">
      <time datetime={date.toISOString()}>{dateStr}</time>
    </div>
  </div>
</a>

<style>
.acard {
  display: flex; flex-direction: column;
  text-decoration: none; cursor: pointer;
  border-top: 1.5px solid var(--ink);
  padding-top: 18px; gap: 12px;
}
.acard:hover .acard-title { opacity: 0.55; }

.acard-img-wrap {
  position: relative; overflow: hidden;
  border-radius: 14px; border: 1px solid var(--border);
}
.acard-img {
  width: 100%; aspect-ratio: 16/9; object-fit: cover;
  transition: transform 0.5s ease;
}
.acard:hover .acard-img { transform: scale(1.03); }
.acard-img-ph {
  width: 100%; aspect-ratio: 16/9; background: #ddd7cd;
}

.acard-tag {
  position: absolute; top: 12px; left: 12px;
  font-family: var(--font-sans); font-size: 8px;
  letter-spacing: 0.18em; text-transform: uppercase;
  background: rgba(253,250,245,0.88); color: var(--ink);
  padding: 3px 9px; border-radius: 999px;
}
.acard-tag--note { background: var(--rust); color: #fdfaf5; }

.acard-body { display: flex; flex-direction: column; gap: 6px; }
.acard-type {
  font-family: var(--font-sans); font-size: 8px;
  letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted);
}
.acard-type--note { color: var(--rust); }
.acard-title {
  font-size: 16px; font-weight: 700; line-height: 1.5;
  transition: opacity 0.2s;
}
.acard--large .acard-title { font-size: 20px; }
.acard-excerpt {
  font-style: italic; font-size: 11px;
  color: var(--muted); line-height: 1.8;
}
.acard-foot {
  font-family: var(--font-sans); font-size: 9px;
  letter-spacing: 0.12em; color: var(--muted);
  margin-top: auto; padding-top: 8px;
  border-top: 1px solid var(--border);
}
</style>
