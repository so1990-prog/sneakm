<footer class="site-footer">
  <img src="/images/logo.png" alt="SNEAKm" class="footer-logo" />
  <div class="footer-right">
    <a href="/privacy" class="footer-link">プライバシーポリシー / 免責事項</a>
    <div class="footer-copy">© 2025 SNEAKm — Personal Archive</div>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--border);
  padding: 24px 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}
.footer-logo { height: 28px; width: auto; opacity: 0.35; }
.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}
.footer-link {
  font-family: var(--font-sans);
  font-size: 9px;
  letter-spacing: 0.12em;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s;
}
.footer-link:hover { color: var(--ink); }
.footer-copy {
  font-family: var(--font-sans);
  font-size: 9px; letter-spacing: 0.14em; color: var(--muted);
}
@media (max-width: 700px) {
  .site-footer { padding: 20px; }
}
</style>
