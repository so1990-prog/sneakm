---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, cover, coverAlt, product } = post.data

const statusLabel = { sale: '販売中', sold: 'SOLD', affiliate: 'アフィリエイト' }
const statusClass = { sale: 'status--sale', sold: 'status--sold', affiliate: 'status--aff' }
---

<a href={`/${post.slug}`} class="pcard">
  <div class="pcard-img-wrap">
    {cover
      ? <Image src={cover} alt={coverAlt ?? title} widths={[300, 500]} class="pcard-img" />
      : <div class="pcard-img-ph" />
    }
    {product?.status && (
      <span class:list={['pcard-status', statusClass[product.status]]}>
        {statusLabel[product.status]}
      </span>
    )}
  </div>
  <div class="pcard-body">
    <div class="pcard-name">{title}</div>
    {post.data.excerpt && <div class="pcard-note">{post.data.excerpt}</div>}
    {product?.price && (
      <div class:list={['pcard-price', product.status === 'sold' && 'pcard-price--sold']}>
        ¥{product.price.toLocaleString()}
      </div>
    )}
  </div>
</a>

<style>
.pcard {
  width: 220px; flex-shrink: 0;
  display: flex; flex-direction: column;
  text-decoration: none; cursor: pointer;
}
.pcard:hover .pcard-img { transform: scale(1.03); }

.pcard-img-wrap {
  border-radius: 16px; overflow: hidden;
  border: 1px solid var(--border);
  position: relative;
}
.pcard-img {
  width: 220px; height: 264px;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.pcard-img-ph {
  width: 220px; height: 264px; background: #ddd7cd;
}

.pcard-status {
  position: absolute; top: 12px; right: 12px;
  font-family: var(--font-sans); font-size: 8px;
  letter-spacing: 0.16em; text-transform: uppercase;
  padding: 3px 9px; border-radius: 999px;
}
.status--sale { background: var(--ink); color: var(--cream); }
.status--sold { background: rgba(28,18,8,0.12); color: var(--muted); }
.status--aff  { background: var(--rust); color: #fdfaf5; }

.pcard-body { padding: 12px 4px 0; display: flex; flex-direction: column; gap: 4px; }
.pcard-name { font-size: 13px; font-weight: 700; line-height: 1.45; }
.pcard-note { font-style: italic; font-size: 10px; color: var(--muted); line-height: 1.7; }
.pcard-price {
  font-family: var(--font-sans); font-size: 13px;
  font-weight: 600; letter-spacing: 0.02em; margin-top: 6px;
}
.pcard-price--sold { color: var(--muted); text-decoration: line-through; }
</style>
