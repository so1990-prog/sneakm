---
import BaseLayout from './BaseLayout.astro'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, date, updatedDate, category, type, excerpt, cover, coverAlt, tags } = post.data

const categoryLabel: Record<string, string> = {
  newbalance: 'New Balance',
  shoes: 'Shoes',
  bag: 'Bag',
  apparel: 'Apparel',
  favorite: 'Favorite',
  gadget: 'Gadget',
}

const dateStr = date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')
const updatedStr = updatedDate?.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')

const ogImage = cover ? cover.src : '/images/og-default.jpg'

const allPosts = await getCollection('posts', ({ data }) => !data.draft)
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt ?? '',
  image: new URL(ogImage, Astro.site).toString(),
  datePublished: date.toISOString(),
  dateModified: (updatedDate ?? date).toISOString(),
  author: { '@type': 'Organization', name: 'SNEAKm スニーカム', url: Astro.site?.toString() },
  publisher: { '@type': 'Organization', name: 'SNEAKm スニーカム', url: Astro.site?.toString() },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SNEAKm', item: Astro.site?.toString() },
    { '@type': 'ListItem', position: 2, name: categoryLabel[category] ?? category, item: new URL(`/category/${category}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
}
---

<BaseLayout title={`${title} | SNEAKm`} description={excerpt} ogImage={ogImage} ogType="article" jsonLd={jsonLd} breadcrumbLd={breadcrumbLd}>
  <article class="post">

    {cover && (
      <div class="post-hero">
        <Image src={cover} alt={coverAlt ?? title} widths={[800, 1200, 1600]} class="post-hero-img" />
      </div>
    )}

    <div class="post-container">

      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">SNEAKm</a>
        <span class="bc-sep">›</span>
        <a href={`/category/${category}/`}>{categoryLabel[category] ?? category}</a>
        <span class="bc-sep">›</span>
        <span class="bc-current">{title}</span>
      </nav>

      <header class="post-header">
        <div class="post-meta">
          <span class="post-cat" class:list={[type === 'note' ? 'note-type' : '']}>
            {type === 'note' ? 'NOTE' : 'SITE'} — {categoryLabel[category]}
          </span>
          <time class="post-date" datetime={date.toISOString()}>{dateStr}</time>
          {updatedStr && <span class="post-updated">updated {updatedStr}</span>}
        </div>
        <h1 class="post-title">{title}</h1>
        {excerpt && <p class="post-excerpt">{excerpt}</p>}
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => <span class="post-tag">#{tag}</span>)}
          </div>
        )}
      </header>

      <div class="promo-notice" aria-label="広告表記">
        <span class="promo-line"></span>
        <span class="promo-text">本ページはプロモーションが含まれています</span>
        <span class="promo-line"></span>
      </div>

      <div class="hukuya-top-bar">
        <span class="hukuya-top-eyebrow">New store open</span>
        <span class="hukuya-top-name">HUKUYA</span>
        <span class="hukuya-top-sub">ヴィンテージ・ユーズド古着</span>
        <span class="hukuya-top-links">
          <a href="https://hukuya-2.myshopify.com/" target="_blank" rel="noopener">Shop →</a>
          <a href="https://www.instagram.com/hukuya_hukuya/" target="_blank" rel="noopener">Instagram →</a>
        </span>
      </div>

      <div class="post-body">
        <slot />
      </div>

      {relatedPosts.length > 0 && (
        <aside class="related">
          <div class="related-label">関連記事</div>
          <div class="related-grid">
            {relatedPosts.map(p => (
              <a href={`/${p.slug}`} class="related-card">
                {p.data.cover
                  ? <Image src={p.data.cover} alt={p.data.coverAlt ?? p.data.title} widths={[400]} class="related-img" />
                  : <div class="related-ph">{p.data.category.toUpperCase()}</div>
                }
                <div class="related-title">{p.data.title}</div>
              </a>
            ))}
          </div>
        </aside>
      )}

      <div class="hukuya-block">
        <div class="hukuya-block-inner">
          <div class="hukuya-block-text">
            <span class="hukuya-block-eyebrow">New store open</span>
            <strong class="hukuya-block-name">HUKUYA</strong>
            <p class="hukuya-block-desc">ヴィンテージ・ユーズド古着のオンラインショップをオープンしました。スニーカーと同じ目線で選んだ服を揃えています。</p>
          </div>
          <div class="hukuya-block-btns">
            <a href="https://hukuya-2.myshopify.com/" target="_blank" rel="noopener" class="hukuya-btn hukuya-btn-shop">Shop →</a>
            <a href="https://www.instagram.com/hukuya_hukuya/" target="_blank" rel="noopener" class="hukuya-btn hukuya-btn-ig">Instagram →</a>
          </div>
        </div>
      </div>

      <footer class="post-footer">
        <a href="/" class="back-link">← トップへ戻る</a>
      </footer>
    </div>

  </article>
</BaseLayout>

<style>
/* ── 記事上部バー ── */
.hukuya-top-bar {
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
  background: var(--ink); color: #fdfaf5;
  padding: 14px 20px;
  margin-bottom: 40px;
}
.hukuya-top-eyebrow {
  font-family: var(--font-sans);
  font-size: 8px; letter-spacing: 0.25em; text-transform: uppercase;
  color: rgba(253,250,245,0.45); white-space: nowrap;
}
.hukuya-top-name {
  font-family: var(--font-serif);
  font-size: 22px; font-weight: 800;
  letter-spacing: -0.01em; line-height: 1;
  color: #fdfaf5;
}
.hukuya-top-sub {
  font-family: var(--font-sans);
  font-size: 10px; letter-spacing: 0.08em;
  color: rgba(253,250,245,0.5); flex: 1;
}
.hukuya-top-links {
  display: flex; gap: 12px; margin-left: auto; flex-shrink: 0;
}
.hukuya-top-links span,
.hukuya-top-links a {
  font-family: var(--font-sans);
  font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
  color: #fdfaf5; text-decoration: none;
  border: 1px solid rgba(253,250,245,0.4);
  padding: 6px 14px; white-space: nowrap;
  transition: background 0.2s;
}
.hukuya-top-links a:hover { background: rgba(253,250,245,0.15); }
@media (max-width: 600px) {
  .hukuya-top-sub { display: none; }
  .hukuya-top-bar { gap: 10px; }
}

/* ── 記事末尾ブロック ── */
.hukuya-block {
  margin: 56px 0 0;
  border: 1.5px solid var(--ink);
}
.hukuya-block-inner {
  padding: 32px 36px;
  display: flex; align-items: center; justify-content: space-between; gap: 32px;
  flex-wrap: wrap;
}
.hukuya-block-text {
  display: flex; flex-direction: column; gap: 10px;
}
.hukuya-block-eyebrow {
  font-family: var(--font-sans);
  font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase;
  color: var(--muted);
}
.hukuya-block-name {
  font-family: var(--font-serif);
  font-size: clamp(28px, 5vw, 40px); font-weight: 800;
  letter-spacing: -0.02em; line-height: 1; color: var(--ink);
}
.hukuya-block-desc {
  font-family: var(--font-sans);
  font-size: 12px; line-height: 1.8; letter-spacing: 0.04em;
  color: var(--muted); max-width: 380px; margin: 0;
}
.hukuya-block-btns {
  display: flex; flex-direction: column; gap: 10px; flex-shrink: 0;
}
.hukuya-btn {
  display: inline-block;
  font-family: var(--font-sans);
  font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
  text-decoration: none;
  padding: 12px 24px;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.hukuya-btn-shop {
  background: var(--ink); color: #fdfaf5;
}
.hukuya-btn-shop:hover { opacity: 0.75; }
.hukuya-btn-ig {
  background: transparent; color: var(--ink);
  border: 1px solid var(--ink);
}
.hukuya-btn-ig:hover { background: var(--ink); color: var(--bg); }
@media (max-width: 600px) {
  .hukuya-block-inner { padding: 24px 20px; }
  .hukuya-block-btns { flex-direction: row; }
}

.post { max-width: 100%; }

.breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  font-family: var(--font-sans);
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 32px;
}
.breadcrumb a {
  color: var(--muted);
  text-decoration: none;
  border-bottom: none;
  transition: color 0.2s;
}
.breadcrumb a:hover { color: var(--ink); }
.bc-sep { color: var(--border); }
.bc-current {
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 40ch;
}

.post-hero {
  width: 100%;
  max-height: 60vh;
  overflow: hidden;
}
.post-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.post-container {
  max-width: 720px;
  margin: 0 auto;
  padding: 48px 32px 80px;
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
  font-family: var(--font-sans);
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}
.post-cat { color: var(--muted); }
.post-cat.note-type { color: var(--rust); }
.post-date { color: var(--muted); }
.post-updated { color: var(--border); font-size: 8px; }

.post-title {
  font-size: clamp(24px, 5vw, 40px);
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -0.01em;
  margin-bottom: 16px;
}

.post-excerpt {
  font-size: 14px;
  line-height: 2;
  color: var(--muted);
  font-style: italic;
  margin-bottom: 20px;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 40px;
}
.post-tag {
  font-family: var(--font-sans);
  font-size: 9px;
  letter-spacing: 0.14em;
  border: 1px solid var(--border);
  padding: 3px 10px;
  border-radius: 999px;
  color: var(--muted);
}

/* プロモーション表記 */
.promo-notice {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 32px;
}
.promo-line {
  flex: 1;
  height: 1px;
  background: var(--border);
}
.promo-text {
  font-family: var(--font-sans);
  font-size: 8px;
  letter-spacing: 0.18em;
  color: var(--muted);
  white-space: nowrap;
}

/* 記事本文 */
.post-body {
  border-top: 1.5px solid var(--ink);
  padding-top: 40px;
  line-height: 2;
  font-size: 15px;
}
.post-body :global(h2) {
  font-size: 22px;
  font-weight: 800;
  margin: 48px 0 16px;
  letter-spacing: -0.01em;
}
.post-body :global(h3) {
  font-size: 18px;
  font-weight: 700;
  margin: 36px 0 12px;
}
.post-body :global(p) { margin-bottom: 1.8em; }
.post-body :global(img) {
  width: 100%;
  border-radius: 16px;
  margin: 32px 0;
  border: 1px solid var(--border);
}
.post-body :global(a) {
  border-bottom: 1px solid var(--ink);
  text-decoration: none;
  transition: opacity 0.2s;
}
.post-body :global(a:hover) { opacity: 0.5; }
.post-body :global(blockquote) {
  border-left: 3px solid var(--ink);
  margin: 32px 0;
  padding: 16px 24px;
  font-style: italic;
  color: var(--muted);
}
.post-body :global(ul), .post-body :global(ol) {
  padding-left: 1.5em;
  margin-bottom: 1.8em;
}
.post-body :global(li) { margin-bottom: 0.5em; }
.post-body :global(table) {
  width: 100%; border-collapse: collapse;
  margin: 32px 0; font-size: 13px;
}
.post-body :global(thead tr) {
  border-bottom: 1.5px solid var(--ink);
}
.post-body :global(th) {
  font-family: var(--font-sans); font-size: 9px;
  letter-spacing: 0.18em; text-transform: uppercase;
  text-align: left; padding: 10px 16px 10px 0;
  color: var(--muted); font-weight: 400;
}
.post-body :global(td) {
  padding: 14px 16px 14px 0;
  border-bottom: 1px solid var(--border);
  line-height: 1.7;
}
.post-body :global(tr:last-child td) { border-bottom: none; }
.post-body :global(td:first-child),
.post-body :global(th:first-child) {
  color: var(--muted);
  font-family: var(--font-sans); font-size: 10px;
  letter-spacing: 0.1em;
}

.related { margin-top: 64px; border-top: 1px solid var(--border); padding-top: 40px; }
.related-label {
  font-family: var(--font-sans); font-size: 9px;
  letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 20px;
}
.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.related-card { text-decoration: none; color: inherit; display: block; }
.related-img { width: 100%; aspect-ratio: 3/2; object-fit: cover; display: block; }
.related-ph {
  width: 100%; aspect-ratio: 3/2;
  background: var(--border); display: flex;
  align-items: center; justify-content: center;
  font-family: var(--font-sans); font-size: 9px;
  letter-spacing: 0.1em; color: var(--muted);
}
.related-title {
  font-size: 12px; line-height: 1.6;
  margin-top: 10px; font-weight: 700;
  transition: opacity 0.2s;
}
.related-card:hover .related-title { opacity: 0.5; }

.post-footer { margin-top: 40px; border-top: 1px solid var(--border); padding-top: 32px; }
.back-link {
  font-family: var(--font-sans);
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--muted);
  transition: color 0.2s;
}
.back-link:hover { color: var(--ink); }

@media (max-width: 700px) {
  .post-container { padding: 32px 20px 60px; }
  .related-grid { grid-template-columns: 1fr 1fr; }
}
</style>
