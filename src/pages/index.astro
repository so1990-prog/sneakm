---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import GalleryGrid from '../components/GalleryGrid.astro'
import ProductCard from '../components/ProductCard.astro'

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const galleryPosts = allPosts.slice(0, 10)
const productPosts = allPosts.filter(p => p.data.product).slice(0, 8)
---

<BaseLayout>
  <!-- GALLERY -->
  <GalleryGrid posts={galleryPosts} />
  <div class="more-wrap">
    <a href="/posts/" class="more-link">記事一覧を見る →</a>
  </div>

  <!-- 商品紹介 -->
  {productPosts.length > 0 && (
    <>
      <div class="sec-label">
        <span class="sec-label-text">商品紹介</span>
        <div class="sec-label-line"></div>
        <span class="sec-label-count">{String(productPosts.length).padStart(2, '0')}</span>
      </div>
      <div class="items-scroll-hint">← scroll →</div>
      <div class="items-wrap">
        <div class="items-strip">
          {productPosts.map(post => <ProductCard post={post} />)}
        </div>
      </div>
    </>
  )}

  <!-- INSTAGRAM -->
  <div class="insta-block">
    <div>
      <div class="insta-at">@sneakm_archive</div>
      <p class="insta-sub">日常のスニーカー記録と、気になる古着をInstagramにも。</p>
    </div>
    <a href="https://instagram.com/sneakm_archive" target="_blank" rel="noopener" class="insta-btn">
      Instagram →
    </a>
  </div>
</BaseLayout>

<style>
/* MORE LINK */
.more-wrap {
  display: flex;
  justify-content: center;
  padding: 0 32px 48px;
}
.more-link {
  font-family: var(--font-sans);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  border: 1.5px solid var(--ink);
  padding: 12px 32px;
  border-radius: 999px;
  color: var(--ink);
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
}
.more-link:hover { background: var(--ink); color: var(--cream); }

/* PRODUCTS */
.items-wrap { overflow-x: auto; padding: 0 32px 48px; -webkit-overflow-scrolling: touch; }
.items-wrap::-webkit-scrollbar { display: none; }
.items-strip { display: flex; gap: 16px; width: max-content; }
.items-scroll-hint {
  display: flex; align-items: center; gap: 8px;
  padding: 0 32px 16px;
  font-family: var(--font-sans); font-size: 8px;
  letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
}
.items-scroll-hint::after { content: ''; flex: 1; height: 1px; background: var(--border); }

/* INSTAGRAM */
.insta-block {
  margin: 0 32px 64px;
  padding: 40px 48px;
  background: var(--ink); border-radius: 24px;
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
}
.insta-at {
  font-family: var(--font-display);
  font-size: 40px; color: var(--cream); letter-spacing: 0.04em; line-height: 1;
}
.insta-sub { font-size: 11px; color: rgba(253,250,245,0.5); font-style: italic; line-height: 1.8; margin-top: 8px; }
.insta-btn {
  font-family: var(--font-sans); font-size: 10px;
  letter-spacing: 0.16em; text-transform: uppercase;
  border: 1.5px solid var(--cream); padding: 12px 28px; border-radius: 999px;
  color: var(--cream); text-decoration: none;
  transition: background 0.2s, color 0.2s;
}
.insta-btn:hover { background: var(--cream); color: var(--ink); }

@media (max-width: 700px) {
  .items-wrap { padding: 0 20px 32px; }
  .items-scroll-hint { padding: 0 20px 16px; }
  .insta-block { margin: 0 20px 48px; padding: 28px 24px; flex-direction: column; align-items: flex-start; }
}
</style>
